{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/comms-submit.schema.json",
  "title": "com.submit arguments (fabric-project-comms/0.1)",
  "description": "What a caller may say. Estate, sender Project, principal and session come from the authenticated endpoint and are never accepted here: an unknown field is refused.",
  "type": "object",
  "required": [
    "idempotency",
    "thread",
    "kind",
    "body"
  ],
  "properties": {
    "idempotency": {
      "$ref": "comms-common.schema.json#/$defs/idempotency"
    },
    "thread": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "comms-common.schema.json#/$defs/opaqueId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "new"
          ],
          "properties": {
            "new": {
              "type": "object",
              "required": [
                "participants"
              ],
              "properties": {
                "participants": {
                  "description": "The Projects that may read this thread, fixed at creation; the sender's Project is added by the board.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "comms-common.schema.json#/$defs/projectId"
                  }
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "kind": {
      "$ref": "comms-common.schema.json#/$defs/messageKind"
    },
    "body": {
      "$ref": "comms-common.schema.json#/$defs/body"
    },
    "replyTo": {
      "$ref": "comms-common.schema.json#/$defs/opaqueId"
    },
    "reaction": {
      "description": "With kind reply only, and only when replyTo is an announcement (DEC-0098).",
      "$ref": "comms-common.schema.json#/$defs/reaction"
    },
    "deliverTo": {
      "description": "With kind reply only (DEC-0135 DR-2).",
      "$ref": "comms-common.schema.json#/$defs/deliverTo"
    },
    "request": {
      "type": "object",
      "required": [
        "target",
        "capability"
      ],
      "properties": {
        "target": {
          "$ref": "comms-common.schema.json#/$defs/projectId"
        },
        "capability": {
          "$ref": "common.schema.json#/$defs/capabilityName"
        },
        "deadline": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "$ref": "comms-common.schema.json#/$defs/artifacts"
    },
    "finding": {
      "description": "Only with kind finding, and optional there (DEC-0080): the severity, the consequence, what the finding affects and its dedupeKey. Here every affects item is distinct and none is {redacted: true}: a sender names what it found, only a reader's copy is redacted.",
      "$ref": "comms-common.schema.json#/$defs/finding",
      "type": "object",
      "properties": {
        "affects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "not": {
              "$ref": "comms-common.schema.json#/$defs/affectedRedacted"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "request": true
        },
        "required": [
          "request"
        ]
      },
      "else": {
        "properties": {
          "request": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reply"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "replyTo": true
        },
        "required": [
          "replyTo"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "finding"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "finding": true
        }
      },
      "else": {
        "properties": {
          "finding": false
        }
      }
    },
    {
      "description": "DEC-0080: a submit that carries a finding uses an idempotency key of at least 22 characters, the least that can hold 128 random bits in the key's alphabet. The key MUST come from a cryptographically secure generator; length is what a schema can check.",
      "if": {
        "properties": {
          "finding": true
        },
        "required": [
          "finding"
        ]
      },
      "then": {
        "properties": {
          "idempotency": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 22
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reply"
          }
        },
        "required": [
          "kind"
        ]
      },
      "else": {
        "properties": {
          "reaction": false,
          "deliverTo": false
        }
      }
    }
  ]
}
