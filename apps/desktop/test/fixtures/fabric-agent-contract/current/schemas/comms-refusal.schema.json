{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/comms-refusal.schema.json",
  "title": "A typed refusal (fabric-project-comms/0.1)",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "comms-common.schema.json#/$defs/refusalCode"
        },
        "message": {
          "description": "One sentence; never names a hidden Project, a participant set or a body.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "const": "held"
          }
        }
      },
      "then": {
        "description": "An operator's hold (DEC-0079) is lifted by the operator, so the same call may be repeated later: held is always retryable.",
        "properties": {
          "retryable": {
            "const": true
          }
        }
      }
    }
  },
  "additionalProperties": false
}
