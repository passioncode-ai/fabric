+      }
+      // Timers may wake before their requested delay. Wait for a monotonic
+      // target, not one timer callback; bounded retries also refuse a broken
+      // injected timer/clock instead of spinning forever.
+      const sampleUntil = clock(monotonic) + policy.sampleWindowMs
+      let wakes = 0
+      for (;;) {
+        const remaining = sampleUntil - clock(monotonic)
+        if (remaining <= 0) break
