[
  {
    "name": "focused",
    "command": [
      "node",
      "--experimental-strip-types",
      "--test",
      "apps/desktop/test/resource-worker-launch.test.mjs",
      "apps/desktop/test/prepared-managed-launch.test.mjs",
      "apps/desktop/test/resource-launch-adapter.test.mjs"
    ],
    "log": "focused-corrected.log",
    "exit": 0
  },
  {
    "name": "types",
    "command": [
      "apps/desktop/node_modules/.bin/tsc",
      "--noEmit",
      "--strict",
      "--skipLibCheck",
      "--target",
      "ES2022",
      "--module",
      "ESNext",
      "--moduleResolution",
      "Bundler",
      "--allowImportingTsExtensions",
      "--typeRoots",
      "$FABRIC_REPO/apps/desktop/node_modules/@types",
      "apps/desktop/src/main/resourceManagedUnit.ts",
      "apps/desktop/src/main/managedLaunch.ts",
      "apps/desktop/src/main/pty.ts",
      "apps/desktop/src/main/resourceLaunchAdapter.ts"
    ],
    "exit": 0,
    "log": "types-corrected.log"
  }
]
