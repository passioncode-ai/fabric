(version 1)(allow default)(deny network*)(deny file-write* (require-not (subpath "{OWNED_HOME}")))(deny file-read* (subpath "{REAL_HOME}/.codex")(subpath "{REAL_HOME}/.claude")(subpath "{REAL_HOME}/.kimi")(subpath "{REAL_HOME}/.hermes")(subpath "{REAL_HOME}/.config")(subpath "{REAL_HOME}/Library/Keychains"))(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.SecurityServer"))(deny file-read* (require-all (subpath "{REAL_HOME}/.kimi-code") (require-not (literal "{REAL_HOME}/.kimi-code/bin/kimi"))))