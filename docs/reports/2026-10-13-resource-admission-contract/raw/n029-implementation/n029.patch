+    ...WINDOW_CHROME,
+    width: 1000,
+    height: 720,
+    title: filePath,
+    webPreferences: { preload: path.join(import.meta.dirname, '../preload/index.cjs'), sandbox: true, additionalArguments: [windowKindArg('editor')] }
+  })
