+        repeated: r.repeated,
+        decisionId: r.decision_id,
+        commitSeq: r.answered_seq === undefined ? null : String(r.answered_seq),
+        unblocked: r.unblocked ?? [],
+        stillBlocked: r.still_blocked ?? [],
