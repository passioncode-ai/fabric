  "servedSchema": {
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}(\\.[a-z][a-z0-9-]{0,31})?$",
        "description": "The callee: a connected product, e.g. fabric-inbox"
      },
      "capability": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$",
        "description": "The product tool to call"
      },
      "input": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {},
        "description": "The tool arguments, exactly as the product takes them"
      },
      "idempotencyKey": {
        "description": "Your own id for this call. Sent again with the same arguments, the same key returns the first answer and sends nothing (while your grant still covers the call and the product is connected); the same key with other arguments is refused. If a call may have reached the product without an answer (a timeout, a cancel, a lost connection), the answer is outcome-unknown, and every later call with that key is refused outcome-unknown: it may have run, so Fabric never sends it again — and a new key would act twice. Check its effect with the product's own read tools (for mail, get_send_status) before you act again. Fabric keeps keys for 24 hours (the 256 most recent per credential) while it runs; hub.json's instance changes when Fabric restarts, and a key from before a restart is unknown to it.",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "agentId",
      "capability",
      "input"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
